        <StackPanel>
            <TextBlock
                Margin="5,0,0,5"
                FontWeight="SemiBold"
                Text="Lookup" />

            <Controls:CardControl Margin="0,0,0,4" Icon="{wpfui:SymbolIcon Symbol=Keyboard24}">
                <Controls:CardControl.Header>
                    <StackPanel Margin="5,0,0,0">
                        <Controls:TextBlock Text="Lookup Shortcut" />
                        <wpfui:TextBlock Foreground="{wpfui:ThemeResource TextFillColorSecondaryBrush}" Text="Hotkey for start Lookup the screen" />
                    </StackPanel>
                </Controls:CardControl.Header>
                <xControls:ShortcutControl x:Name="captureShortcut" KeySetChanged="ShortcutControl_KeySetChanged" />
            </Controls:CardControl>

            <Controls:CardControl Margin="0,0,0,4" Icon="{wpfui:SymbolIcon Symbol=DrawImage24}">
                <Controls:CardControl.Header>
                    <StackPanel Margin="5,0,0,0">
                        <Controls:TextBlock Text="Lookup Method" />
                        <wpfui:TextBlock Foreground="{wpfui:ThemeResource TextFillColorSecondaryBrush}" Text="How does the result show after Lookup" />
                    </StackPanel>
                </Controls:CardControl.Header>

                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <!--  On Line Text (Bold when unchecked)  -->
                    <Controls:TextBlock VerticalAlignment="Center" Text="On Line">
                        <Controls:TextBlock.Style>
                            <Style TargetType="Controls:TextBlock">
                                <Setter Property="FontWeight" Value="Normal" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=lookupToggle}" Value="False">
                                        <DataTrigger.Setters>
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger.Setters>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Controls:TextBlock.Style>
                    </Controls:TextBlock>

                    <!--  Custom Unfilled Toggle Switch  -->
                    <CheckBox
                        x:Name="lookupToggle"
                        Margin="10,0"
                        VerticalAlignment="Center"
                        IsChecked="{Binding LookupOnImage}">
                        <CheckBox.Style>
                            <Style TargetType="CheckBox">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="CheckBox">
                                            <Grid Background="Transparent" Cursor="Hand">
                                                <Border
                                                    x:Name="track"
                                                    Width="40"
                                                    Height="20"
                                                    Background="Transparent"
                                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10">
                                                    <Ellipse
                                                        x:Name="knob"
                                                        Width="12"
                                                        Height="12"
                                                        Margin="3,0,0,0"
                                                        HorizontalAlignment="Left"
                                                        Fill="{DynamicResource TextFillColorPrimaryBrush}" />
                                                </Border>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right" />
                                                    <Setter TargetName="knob" Property="Margin" Value="0,0,3,0" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </CheckBox.Style>
                    </CheckBox>

                    <!--  On Image Text (Bold when checked)  -->
                    <Controls:TextBlock VerticalAlignment="Center" Text="On Image">
                        <Controls:TextBlock.Style>
                            <Style TargetType="Controls:TextBlock">
                                <Setter Property="FontWeight" Value="Normal" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=lookupToggle}" Value="True">
                                        <DataTrigger.Setters>
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger.Setters>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Controls:TextBlock.Style>
                    </Controls:TextBlock>
                </StackPanel>
            </Controls:CardControl>

