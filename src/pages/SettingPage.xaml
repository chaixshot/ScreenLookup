<Page
    x:Class="ScreenLookup.src.pages.SettingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ScreenLookup.src.pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:xControls="clr-namespace:ScreenLookup.src.controls"
    Title="Setting"
    mc:Ignorable="d">

    <StackPanel Margin="20,12,20,40">
        <!--  General  -->
        <StackPanel>
            <TextBlock
                Margin="5,0,0,5"
                FontWeight="SemiBold"
                Text="General" />

            <Controls:CardControl Margin="0,0,0,4" Icon="{wpfui:SymbolIcon Symbol=ClipboardTask24}">
                <Controls:CardControl.Header>
                    <StackPanel Margin="5,0,0,0">
                        <Controls:TextBlock Text="Startup With Windows" />
                        <wpfui:TextBlock Foreground="{wpfui:ThemeResource TextFillColorSecondaryBrush}" Text="Auto start ScreenLookup when login" />
                    </StackPanel>
                </Controls:CardControl.Header>
                <CheckBox IsChecked="{Binding StartupWithWindows}" />
            </Controls:CardControl>

            <Controls:CardControl Margin="0,0,0,4" Icon="{wpfui:SymbolIcon Symbol=SlideHide24}">
                <Controls:CardControl.Header>
                    <StackPanel Margin="5,0,0,0">
                        <Controls:TextBlock Text="Start In Background" />
                        <wpfui:TextBlock Foreground="{wpfui:ThemeResource TextFillColorSecondaryBrush}" Text="Hide ScreenLook to tray after starting" />
                    </StackPanel>
                </Controls:CardControl.Header>
                <CheckBox IsChecked="{Binding StartInBackground}" />
            </Controls:CardControl>

            <Controls:CardControl Margin="0,0,0,4" Icon="{wpfui:SymbolIcon Symbol=Apps24}">
                <Controls:CardControl.Header>
                    <StackPanel Margin="5,0,0,0">
                        <Controls:TextBlock Text="Minimize To Tray" />
                        <wpfui:TextBlock Foreground="{wpfui:ThemeResource TextFillColorSecondaryBrush}" Text="Allow ScreenLookup hide to tray when minimizing and closing" />
                    </StackPanel>
                </Controls:CardControl.Header>
                <CheckBox IsChecked="{Binding MinimizeToTray}" />
            </Controls:CardControl>
        </StackPanel>

        <!--  Language  -->
        <StackPanel>
            <TextBlock
                Margin="5,0,0,5"
                FontWeight="SemiBold"
                Text="Language" />

            <Controls:CardControl Margin="0,0,0,4" Icon="{wpfui:SymbolIcon Symbol=BrainCircuit24}">
                <Controls:CardControl.Header>
                    <StackPanel Margin="5,0,0,0">
                        <Controls:TextBlock Text="OCR Engine Mode" />
                        <wpfui:TextBlock Foreground="{wpfui:ThemeResource TextFillColorSecondaryBrush}" Text="Choose Optical Character Recognition engine mode" />
                    </StackPanel>
                </Controls:CardControl.Header>
                <ComboBox
                    x:Name="ocrEngineMode"
                    Width="200"
                    SelectedValue="{Binding OcrEngineMode}"
                    SelectionChanged="OcrEngineMode_SelectionChanged" />
            </Controls:CardControl>

            <Controls:CardControl Margin="0,0,0,4" Icon="{wpfui:SymbolIcon Symbol=LocalLanguage24}">
                <Controls:CardControl.Header>
                    <StackPanel Margin="5,0,0,0">
                        <Controls:TextBlock Text="Source Language" />
                        <wpfui:TextBlock Foreground="{wpfui:ThemeResource TextFillColorSecondaryBrush}" Text="Capture target language" />
                    </StackPanel>
                </Controls:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <Controls:Button
                        x:Name="downloadTesseract"
                        Margin="0,0,5,0"
                        Click="DownloadTesseractButton_Click">
                        <StackPanel>
                            <wpfui:ProgressRing
                                x:Name="tesseractLoadingIcon"
                                Width="12"
                                Height="12"
                                Foreground="{wpfui:ThemeResource TextFillColorPrimaryBrush}"
                                IsIndeterminate="True" />
                            <Controls:SymbolIcon
                                x:Name="tesseractLoadIcon"
                                Filled="True"
                                Symbol="ArrowDownload24" />
                        </StackPanel>
                    </Controls:Button>
                    <ComboBox
                        x:Name="sourceLanguageAccuracy"
                        Width="146"
                        SelectedValue="{Binding SourceLanguageAccuracy}"
                        SelectionChanged="SourceLanguageAccuracy_SelectionChanged" />
                    <ComboBox
                        x:Name="sourceLanguage"
                        Width="200"
                        Margin="5,0,0,0"
                        SelectionChanged="SourceLanguage_SelectionChanged" />
                </StackPanel>
            </Controls:CardControl>


            <Controls:CardControl
                Margin="0,0,0,4"
                Padding="14,8,14,8"
                Icon="{wpfui:SymbolIcon Symbol=Checkmark24}">
                <Controls:CardControl.Header>
                    <StackPanel Margin="5,0,0,0">
                        <Controls:TextBlock Text="Source Language Correction (Hunspell)" />
                        <wpfui:TextBlock Foreground="{wpfui:ThemeResource TextFillColorSecondaryBrush}" Text="Replace the words that are similar to recognized ones in dictionary" />
                        <wpfui:HyperlinkButton
                            Padding="0"
                            Content="Read more"
                            Icon="{wpfui:SymbolIcon Link24}"
                            NavigateUri="https://hunspell.github.io/" />
                    </StackPanel>
                </Controls:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <Controls:Button
                        x:Name="downloadHunspell"
                        Margin="0,0,5,0"
                        Click="DownloadHunspellButton_Click">
                        <StackPanel>
                            <wpfui:ProgressRing
                                x:Name="hunspellLoadingIcon"
                                Width="12"
                                Height="12"
                                Foreground="{wpfui:ThemeResource TextFillColorPrimaryBrush}"
                                IsIndeterminate="True" />
                            <Controls:SymbolIcon
                                x:Name="hunspellLoadIcon"
                                Filled="True"
                                Symbol="ArrowDownload24" />
                        </StackPanel>
                    </Controls:Button>
                    <CheckBox
                        x:Name="hunspell"
                        Click="HunSpell_Click"
                        IsChecked="{Binding HunSpell}" />
                </StackPanel>
            </Controls:CardControl>

            <Controls:CardControl Margin="0,0,0,4" Icon="{wpfui:SymbolIcon Symbol=LocalLanguage24}">
                <Controls:CardControl.Header>
                    <StackPanel Margin="5,0,0,0">
                        <Controls:TextBlock Text="Target Language" />
                        <wpfui:TextBlock Foreground="{wpfui:ThemeResource TextFillColorSecondaryBrush}" Text="Language for translating to your native language" />
                    </StackPanel>
                </Controls:CardControl.Header>
                <ComboBox
                    x:Name="targetLanguage"
                    Width="200"
                    SelectedIndex="{Binding TargetLanguage}" />
            </Controls:CardControl>

            <Controls:CardControl Margin="0,0,0,4" Icon="{wpfui:SymbolIcon Symbol=Translate24}">
                <Controls:CardControl.Header>
                    <StackPanel Margin="5,0,0,0">
                        <Controls:TextBlock Text="Word Translation Provider" />
                        <wpfui:TextBlock Foreground="{wpfui:ThemeResource TextFillColorSecondaryBrush}" Text="Provider for word translation service" />
                    </StackPanel>
                </Controls:CardControl.Header>
                <ComboBox
                    x:Name="translationProvider"
                    Width="200"
                    SelectedValue="{Binding WordTranslationProvider}"
                    SelectionChanged="TranslationProvider_SelectionChanged" />
            </Controls:CardControl>

            <Controls:CardControl Margin="0,0,0,4" Icon="{wpfui:SymbolIcon Symbol=Translate24}">
                <Controls:CardControl.Header>
                    <StackPanel Margin="5,0,0,0">
                        <Controls:TextBlock Text="Paragraph Translation Provider" />
                        <wpfui:TextBlock Foreground="{wpfui:ThemeResource TextFillColorSecondaryBrush}" Text="Provider for paragraph translation service" />
                    </StackPanel>
                </Controls:CardControl.Header>
                <ComboBox
                    x:Name="paragraphProvider"
                    Width="200"
                    SelectedValue="{Binding ParagraphTranslationProvider}"
                    SelectionChanged="ParagraphProvider_SelectionChanged" />
            </Controls:CardControl>

            <Controls:CardControl Margin="0,0,0,4" Icon="{wpfui:SymbolIcon Symbol=PersonVoice24}">
                <Controls:CardControl.Header>

                    <StackPanel Margin="5,0,0,0">
                        <Controls:TextBlock Text="Text-To-Speech Provider" />
                        <wpfui:TextBlock Foreground="{wpfui:ThemeResource TextFillColorSecondaryBrush}" Text="Provider for Text-To-Speech service" />
                    </StackPanel>
                </Controls:CardControl.Header>
                <ComboBox
                    x:Name="ttsProvider"
                    Width="200"
                    SelectedValue="{Binding TTSProvider}" />
            </Controls:CardControl>

        </StackPanel>

        <!--  Ollama  -->
        <StackPanel x:Name="ollamaApiSettingPanel">
            <TextBlock
                Margin="5,0,0,5"
                FontWeight="SemiBold"
                Text="Ollama API" />

            <Controls:CardControl Margin="0,0,0,4" Icon="{wpfui:SymbolIcon Symbol=BrainCircuit24}">
                <Controls:CardControl.Header>
                    <StackPanel Margin="5,0,0,0">
                        <Controls:TextBlock Text="Model Name" />
                        <wpfui:TextBlock Foreground="{wpfui:ThemeResource TextFillColorSecondaryBrush}" Text="Model identifier for translation and generation" />
                    </StackPanel>
                </Controls:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <wpfui:Button
                        Width="32"
                        Height="32"
                        Margin="0,0,10,0"
                        Padding="0,0,0,0"
                        Click="OllamaLoadModelsButton_Click"
                        ToolTip="Fetch Models">
                        <wpfui:SymbolIcon Symbol="ArrowClockwise24" />
                    </wpfui:Button>
                    <ComboBox
                        x:Name="ollamaModelComboBox"
                        Width="200"
                        DisplayMemberPath="Id"
                        IsEditable="True"
                        SelectedValuePath="Id"
                        Text="{Binding OllamaConfig.ModelName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Controls:CardControl>

            <Controls:CardControl Margin="0,0,0,4" Icon="{wpfui:SymbolIcon Symbol=BrainCircuit24}">
                <Controls:CardControl.Header>
                    <StackPanel Margin="5,0,0,0">
                        <Controls:TextBlock Text="Temperature" />
                        <wpfui:TextBlock Foreground="{wpfui:ThemeResource TextFillColorSecondaryBrush}" Text="Controls the randomness, variability, and creativity of a text generation" />
                    </StackPanel>
                </Controls:CardControl.Header>
                <Controls:NumberBox
                    Width="200"
                    Maximum="2"
                    Minimum="0"
                    Value="{Binding OllamaConfig.Temperature, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Controls:CardControl>

            <Controls:CardControl Margin="0,0,0,4" Icon="{wpfui:SymbolIcon Symbol=BrainCircuit24}">
                <Controls:CardControl.Header>
                    <StackPanel Margin="5,0,0,0">
                        <Controls:TextBlock Text="API Url" />
                        <wpfui:TextBlock Foreground="{wpfui:ThemeResource TextFillColorSecondaryBrush}" Text="API endpoint URL" />
                    </StackPanel>
                </Controls:CardControl.Header>
                <TextBox
                    Width="200"
                    HorizontalContentAlignment="Left"
                    Text="{Binding OllamaConfig.ApiUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Controls:CardControl>

            <Controls:CardControl Margin="0,0,0,4" Icon="{wpfui:SymbolIcon Symbol=BrainCircuit24}">
                <Controls:CardControl.Header>
                    <StackPanel Margin="5,0,0,0">
                        <Controls:TextBlock Text="Prompt" />
                        <wpfui:TextBlock Foreground="{wpfui:ThemeResource TextFillColorSecondaryBrush}" Text="System prompt for LLM translation" />
                    </StackPanel>
                </Controls:CardControl.Header>
                <TextBox
                    Width="400"
                    Height="80"
                    HorizontalContentAlignment="Left"
                    AcceptsReturn="True"
                    Text="{Binding OllamaConfig.TranslatePrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />
            </Controls:CardControl>

            <Controls:CardControl Margin="0,0,0,4" Icon="{wpfui:SymbolIcon Symbol=BrainCircuit24}">
                <Controls:CardControl.Header>
                    <StackPanel Margin="5,0,0,0">
                        <Controls:TextBlock Text="Extra Details System Prompt" />
                        <wpfui:TextBlock Foreground="{wpfui:ThemeResource TextFillColorSecondaryBrush}" Text="System prompt for dictionary extra details generation" />
                    </StackPanel>
                </Controls:CardControl.Header>
                <TextBox
                    Width="400"
                    Height="80"
                    HorizontalContentAlignment="Left"
                    AcceptsReturn="True"
                    Text="{Binding OllamaConfig.ExtraDetailSystemPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />
            </Controls:CardControl>

            <Controls:CardControl Margin="0,0,0,4" Icon="{wpfui:SymbolIcon Symbol=BrainCircuit24}">
                <Controls:CardControl.Header>
                    <StackPanel Margin="5,0,0,0">
                        <Controls:TextBlock Text="Extra Details User Prompt" />
                        <wpfui:TextBlock Foreground="{wpfui:ThemeResource TextFillColorSecondaryBrush}" Text="User prompt template for dictionary extra details generation" />
                    </StackPanel>
                </Controls:CardControl.Header>
                <TextBox
                    Width="400"
                    Height="80"
                    HorizontalContentAlignment="Left"
                    AcceptsReturn="True"
                    Text="{Binding OllamaConfig.ExtraDetailPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />
            </Controls:CardControl>

            <Controls:CardControl Margin="0,0,0,4" Icon="{wpfui:SymbolIcon Symbol=Clock24}">
                <Controls:CardControl.Header>
                    <StackPanel Margin="5,0,0,0">
                        <Controls:TextBlock Text="Timeout (seconds)" />
                        <wpfui:TextBlock Foreground="{wpfui:ThemeResource TextFillColorSecondaryBrush}" Text="API request timeout" />
                    </StackPanel>
                </Controls:CardControl.Header>
                <Controls:NumberBox
                    Width="200"
                    Maximum="300"
                    Minimum="5"
                    Value="{Binding OllamaConfig.TimeoutSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Controls:CardControl>

        </StackPanel>

        <!--  LMStudio  -->
        <StackPanel x:Name="lmstudioApiSettingPanel">
            <TextBlock
                Margin="5,0,0,5"
                FontWeight="SemiBold"
                Text="LMStudio API" />

            <Controls:CardControl Margin="0,0,0,4" Icon="{wpfui:SymbolIcon Symbol=BrainCircuit24}">
                <Controls:CardControl.Header>
