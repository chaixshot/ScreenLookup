                        Height="32"
                        Margin="0,0,10,0"
                        Padding="0"
                        Click="LMStudioLoadModelsButton_Click"
                        ToolTip="Fetch Models">
                        <wpfui:SymbolIcon Symbol="ArrowClockwise24" />
                    </Controls:Button>
                    <ComboBox
                        x:Name="lmstudioModelComboBox"
                        Width="200"
                        DisplayMemberPath="Id"
                        IsEditable="True"
                        SelectedValuePath="Id"
                        Text="{Binding LMStudioConfig.ModelName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Controls:CardControl>

            <Controls:CardControl Margin="0,0,0,4" Icon="{wpfui:SymbolIcon Symbol=BrainCircuit24}">
                <Controls:CardControl.Header>
                    <StackPanel Margin="5,0,0,0">
                        <Controls:TextBlock Text="Temperature" />
                        <wpfui:TextBlock Foreground="{wpfui:ThemeResource TextFillColorSecondaryBrush}" Text="Controls the randomness, variability, and creativity of a text generation" />
                    </StackPanel>
                </Controls:CardControl.Header>
                <Controls:NumberBox
                    Width="200"
                    Maximum="2"
                    Minimum="0"
                    Value="{Binding LMStudioConfig.Temperature, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Controls:CardControl>

            <Controls:CardControl Margin="0,0,0,4" Icon="{wpfui:SymbolIcon Symbol=BrainCircuit24}">
                <Controls:CardControl.Header>
                    <StackPanel Margin="5,0,0,0">
                        <Controls:TextBlock Text="API Url" />
                        <wpfui:TextBlock Foreground="{wpfui:ThemeResource TextFillColorSecondaryBrush}" Text="API endpoint URL" />
                    </StackPanel>
                </Controls:CardControl.Header>
                <TextBox
                    Width="200"
                    HorizontalContentAlignment="Left"
                    Text="{Binding LMStudioConfig.ApiUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Controls:CardControl>

            <Controls:CardControl Margin="0,0,0,4" Icon="{wpfui:SymbolIcon Symbol=BrainCircuit24}">
                <Controls:CardControl.Header>
                    <StackPanel Margin="5,0,0,0">
                        <Controls:TextBlock Text="Prompt" />
                        <wpfui:TextBlock Foreground="{wpfui:ThemeResource TextFillColorSecondaryBrush}" Text="System prompt for LLM translation" />
                    </StackPanel>
                </Controls:CardControl.Header>
                <TextBox
                    Width="400"
                    Height="80"
                    HorizontalContentAlignment="Left"
                    AcceptsReturn="True"
                    Text="{Binding LMStudioConfig.TranslatePrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />
            </Controls:CardControl>

            <Controls:CardControl Margin="0,0,0,4" Icon="{wpfui:SymbolIcon Symbol=BrainCircuit24}">
                <Controls:CardControl.Header>
                    <StackPanel Margin="5,0,0,0">
                        <Controls:TextBlock Text="Extra Details System Prompt" />
                        <wpfui:TextBlock Foreground="{wpfui:ThemeResource TextFillColorSecondaryBrush}" Text="System prompt for dictionary extra details generation" />
                    </StackPanel>
                </Controls:CardControl.Header>
                <TextBox
                    Width="400"
                    Height="80"
                    HorizontalContentAlignment="Left"
                    AcceptsReturn="True"
                    Text="{Binding LMStudioConfig.ExtraDetailSystemPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />
            </Controls:CardControl>

            <Controls:CardControl Margin="0,0,0,4" Icon="{wpfui:SymbolIcon Symbol=BrainCircuit24}">
                <Controls:CardControl.Header>
                    <StackPanel Margin="5,0,0,0">
                        <Controls:TextBlock Text="Extra Details User Prompt" />
                        <wpfui:TextBlock Foreground="{wpfui:ThemeResource TextFillColorSecondaryBrush}" Text="User prompt template for dictionary extra details generation" />
                    </StackPanel>
                </Controls:CardControl.Header>
                <TextBox
                    Width="400"
                    Height="80"
                    HorizontalContentAlignment="Left"
                    AcceptsReturn="True"
                    Text="{Binding LMStudioConfig.ExtraDetailPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />
            </Controls:CardControl>

            <Controls:CardControl Margin="0,0,0,4" Icon="{wpfui:SymbolIcon Symbol=Clock24}">
                <Controls:CardControl.Header>
                    <StackPanel Margin="5,0,0,0">
                        <Controls:TextBlock Text="Timeout (seconds)" />
                        <wpfui:TextBlock Foreground="{wpfui:ThemeResource TextFillColorSecondaryBrush}" Text="API request timeout" />
                    </StackPanel>
                </Controls:CardControl.Header>
                <Controls:NumberBox
                    Width="200"
                    Maximum="300"
                    Minimum="5"
                    Value="{Binding LMStudioConfig.TimeoutSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Controls:CardControl>

        </StackPanel>

        <!--  OpenAI  -->
        <StackPanel x:Name="openaiApiSettingPanel">
            <TextBlock
                Margin="5,0,0,5"
                FontWeight="SemiBold"
                Text="OpenAI API" />

            <Controls:CardControl Margin="0,0,0,4" Icon="{wpfui:SymbolIcon Symbol=BrainCircuit24}">
                <Controls:CardControl.Header>
                    <StackPanel Margin="5,0,0,0">
                        <Controls:TextBlock Text="API Key" />
                        <wpfui:TextBlock Foreground="{wpfui:ThemeResource TextFillColorSecondaryBrush}" Text="API authentication key" />
                    </StackPanel>
                </Controls:CardControl.Header>
                <TextBox
                    Width="200"
                    HorizontalContentAlignment="Left"
                    Text="{Binding OpenAIConfig.ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Controls:CardControl>

            <Controls:CardControl Margin="0,0,0,4" Icon="{wpfui:SymbolIcon Symbol=BrainCircuit24}">
                <Controls:CardControl.Header>
                    <StackPanel Margin="5,0,0,0">
                        <Controls:TextBlock Text="Model Name" />
                        <wpfui:TextBlock Foreground="{wpfui:ThemeResource TextFillColorSecondaryBrush}" Text="Model identifier for translation and generation" />
                    </StackPanel>
                </Controls:CardControl.Header>
                <TextBox
                    Width="200"
                    HorizontalContentAlignment="Left"
                    Text="{Binding OpenAIConfig.ModelName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Controls:CardControl>

            <Controls:CardControl Margin="0,0,0,4" Icon="{wpfui:SymbolIcon Symbol=BrainCircuit24}">
                <Controls:CardControl.Header>
                    <StackPanel Margin="5,0,0,0">
                        <Controls:TextBlock Text="Temperature" />
                        <wpfui:TextBlock Foreground="{wpfui:ThemeResource TextFillColorSecondaryBrush}" Text="Controls the randomness, variability, and creativity of a text generation" />
                    </StackPanel>
                </Controls:CardControl.Header>
                <Controls:NumberBox
                    Width="200"
                    Maximum="2"
                    Minimum="0"
                    Value="{Binding OpenAIConfig.Temperature, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Controls:CardControl>

            <Controls:CardControl Margin="0,0,0,4" Icon="{wpfui:SymbolIcon Symbol=BrainCircuit24}">
                <Controls:CardControl.Header>
                    <StackPanel Margin="5,0,0,0">
                        <Controls:TextBlock Text="API Url" />
                        <wpfui:TextBlock Foreground="{wpfui:ThemeResource TextFillColorSecondaryBrush}" Text="API endpoint URL" />
                    </StackPanel>
                </Controls:CardControl.Header>
                <TextBox
                    Width="200"
                    HorizontalContentAlignment="Left"
                    Text="{Binding OpenAIConfig.ApiUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Controls:CardControl>

            <Controls:CardControl Margin="0,0,0,4" Icon="{wpfui:SymbolIcon Symbol=BrainCircuit24}">
                <Controls:CardControl.Header>
                    <StackPanel Margin="5,0,0,0">
                        <Controls:TextBlock Text="Prompt" />
                        <wpfui:TextBlock Foreground="{wpfui:ThemeResource TextFillColorSecondaryBrush}" Text="System prompt for LLM translation" />
                    </StackPanel>
                </Controls:CardControl.Header>
                <TextBox
                    Width="400"
                    Height="80"
                    HorizontalContentAlignment="Left"
                    AcceptsReturn="True"
                    Text="{Binding OpenAIConfig.TranslatePrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />
            </Controls:CardControl>

            <Controls:CardControl Margin="0,0,0,4" Icon="{wpfui:SymbolIcon Symbol=BrainCircuit24}">
                <Controls:CardControl.Header>
                    <StackPanel Margin="5,0,0,0">
                        <Controls:TextBlock Text="Extra Details System Prompt" />
                        <wpfui:TextBlock Foreground="{wpfui:ThemeResource TextFillColorSecondaryBrush}" Text="System prompt for dictionary extra details generation" />
                    </StackPanel>
                </Controls:CardControl.Header>
                <TextBox
                    Width="400"
                    Height="80"
                    AcceptsReturn="True"
                    Text="{Binding OpenAIConfig.ExtraDetailSystemPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />
            </Controls:CardControl>

            <Controls:CardControl Margin="0,0,0,4" Icon="{wpfui:SymbolIcon Symbol=BrainCircuit24}">
                <Controls:CardControl.Header>
                    <StackPanel Margin="5,0,0,0">
                        <Controls:TextBlock Text="Extra Details User Prompt" />
                        <wpfui:TextBlock Foreground="{wpfui:ThemeResource TextFillColorSecondaryBrush}" Text="User prompt template for dictionary extra details generation" />
                    </StackPanel>
                </Controls:CardControl.Header>
                <TextBox
                    Width="400"
                    Height="80"
                    HorizontalContentAlignment="Left"
                    AcceptsReturn="True"
                    Text="{Binding OpenAIConfig.ExtraDetailPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />
            </Controls:CardControl>

            <Controls:CardControl Margin="0,0,0,4" Icon="{wpfui:SymbolIcon Symbol=Clock24}">
                <Controls:CardControl.Header>
                    <StackPanel Margin="5,0,0,0">
                        <Controls:TextBlock Text="Timeout (seconds)" />
                        <wpfui:TextBlock Foreground="{wpfui:ThemeResource TextFillColorSecondaryBrush}" Text="API request timeout" />
                    </StackPanel>
                </Controls:CardControl.Header>
                <Controls:NumberBox
                    Width="200"
                    Maximum="300"
                    Minimum="5"
                    Value="{Binding OpenAIConfig.TimeoutSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Controls:CardControl>

        </StackPanel>

        <!--  OpenRouter  -->
        <StackPanel x:Name="openrouterApiSettingPanel">
            <TextBlock
                Margin="5,0,0,5"
                FontWeight="SemiBold"
                Text="OpenRouter API" />

            <Controls:CardControl Margin="0,0,0,4" Icon="{wpfui:SymbolIcon Symbol=BrainCircuit24}">
                <Controls:CardControl.Header>
                    <StackPanel Margin="5,0,0,0">
                        <Controls:TextBlock Text="API Key" />
                        <wpfui:TextBlock Foreground="{wpfui:ThemeResource TextFillColorSecondaryBrush}" Text="API authentication key" />
                    </StackPanel>
                </Controls:CardControl.Header>
                <TextBox
                    Width="200"
                    HorizontalContentAlignment="Left"
                    Text="{Binding OpenRouterConfig.ApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Controls:CardControl>

            <Controls:CardControl Margin="0,0,0,4" Icon="{wpfui:SymbolIcon Symbol=BrainCircuit24}">
                <Controls:CardControl.Header>
                    <StackPanel Margin="5,0,0,0">
                        <Controls:TextBlock Text="API Url" />
                        <wpfui:TextBlock Foreground="{wpfui:ThemeResource TextFillColorSecondaryBrush}" Text="API endpoint URL" />
                    </StackPanel>
                </Controls:CardControl.Header>
                <TextBox
                    Width="200"
                    HorizontalContentAlignment="Left"
                    Text="{Binding OpenRouterConfig.ApiUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Controls:CardControl>

            <Controls:CardControl Margin="0,0,0,4" Icon="{wpfui:SymbolIcon Symbol=BrainCircuit24}">
                <Controls:CardControl.Header>
