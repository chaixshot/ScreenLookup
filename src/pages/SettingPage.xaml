                        <Controls:TextBlock Text="Model Name" />
                        <wpfui:TextBlock Foreground="{wpfui:ThemeResource TextFillColorSecondaryBrush}" Text="Model identifier for translation and generation" />
                    </StackPanel>
                </Controls:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <Controls:Button
