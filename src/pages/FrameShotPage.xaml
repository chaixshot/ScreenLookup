<Page
    x:Class="ScreenLookup.src.pages.FrameShotPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="FrameShot Settings">

    <Grid Margin="20">
        <ScrollViewer>
            <StackPanel>
                <TextBlock
                    FontSize="24"
                    FontWeight="Bold"
                    Text="FrameShot (VR Capture)" />

                <Controls:Card>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Status" />
                        <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                            <Ellipse
                                x:Name="StatusDot"
                                Width="10"
                                Height="10"
                                Fill="Red" />
                            <TextBlock
                                x:Name="StatusText"
                                Margin="10,0,0,0"
                                Text="Not Connected" />
                        </StackPanel>
                        <Controls:Button
                            x:Name="StatusButton"
                            Margin="0,10,0,0"
                            Click="Connect_Click"
                            Content="Connect to SteamVR" />
                    </StackPanel>
                </Controls:Card>

                <Controls:Card>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Activation" />
                        <TextBlock
                            FontSize="12"
                            Foreground="Gray"
                            Text="How close your hands must be to start framing" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider
                                x:Name="ActivationRadius"
                                IsSnapToTickEnabled="True"
                                Maximum="30"
                                Minimum="5"
                                TickFrequency="1"
                                ValueChanged="ActivationRadius_ValueChanged"
                                Value="0.15" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Text="{Binding ElementName=ActivationRadius, Path=Value, StringFormat={}{0} cm}" />
                        </Grid>
                    </StackPanel>
                </Controls:Card>

                <Controls:Card>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="Photo Settings" />
                        <CheckBox
                            x:Name="HmdRotCheck"
                            Margin="0,10,0,0"
                            Checked="HmdRotCheck_Changed"
                            Content="Use HMD Rotations (Tilt frame with head)"
                            Unchecked="HmdRotCheck_Changed" />
                    </StackPanel>
                </Controls:Card>

                <Controls:Card>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="How to use" />
                        <TextBlock Margin="0,5,0,0" TextWrapping="Wrap">
                            1. Bring both VR controllers together.<LineBreak />
                            2. Hold the Grip buttons on both.<LineBreak />
                            3. Pull hands apart to create the capture frame.<LineBreak />
                            4. Release the Right Grip to take the photo, or Left to cancel.</TextBlock>
                    </StackPanel>
                </Controls:Card>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>