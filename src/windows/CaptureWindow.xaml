<Controls:FluentWindow
    x:Class="ScreenLookup.src.windows.CaptureWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ScreenLookup.src.controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:xControls="clr-namespace:ScreenLookup.src.controls"
    x:Name="captureWindow"
    Title="Capture"
    MinHeight="0"
    Background="Transparent"
    Deactivated="App_Deactivated"
    ExtendsContentIntoTitleBar="True"
    MouseLeftButtonDown="captureWindow_MouseDown"
    RenderOptions.ClearTypeHint="Enabled"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    TextOptions.TextFormattingMode="Ideal"
    TextOptions.TextRenderingMode="ClearType"
    Topmost="True"
    WindowBackdropType="Mica"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <Grid>
        <Grid x:Name="MainGrid" Margin="15,0,15,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <xControls:WordFlyout x:Name="flayOut" Grid.Row="5" />

                <StackPanel
                    Margin="0,5,0,5"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Controls:Button
                        x:Name="CopyImageButton"
                        Margin="0,0,2,0"
                        Click="CopyImageButton_Click"
                        Icon="{wpfui:SymbolIcon Symbol=Copy24,
                                                Filled=False}"
                        ToolTip="Copy Image to Clipboard" />

                    <Controls:Button
                        x:Name="SaveImageButton"
                        Margin="0,0,2,0"
                        Click="SaveImageButton_Click"
                        Icon="{wpfui:SymbolIcon Symbol=Save24,
                                                Filled=False}"
                        ToolTip="Save Image to Disk" />

                    <Controls:Button
                        x:Name="TopmostButton"
                        Click="TopmostButton_Click"
                        Icon="{wpfui:SymbolIcon Symbol=Pin16,
                                                Filled=True}"
                        ToolTip="Always on Top" />
                </StackPanel>

                <Grid
                    x:Name="configMenu"
                    Grid.Row="1"
                    Margin="15">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ComboBox x:Name="sourceLanguageConfig" SelectionChanged="SourceLanguageConfig_SelectionChanged" />

                            <Controls:SymbolIcon Grid.Column="1" Symbol="ChevronRight24" />

                            <ComboBox
                                x:Name="targetLanguageConfig"
                                Grid.Column="2"
                                SelectionChanged="TargetLanguageConfig_SelectionChanged" />
                        </Grid>

                        <Controls:Card Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Controls:TextBlock Text="Source Language Correction (Hunspell)" />

                                <Controls:ToggleSwitch
                                    x:Name="hunSpell"
                                    Grid.Column="1"
                                    Click="ConfigSwitch_Toggle"
                                    IsChecked="{Binding HunSpell}" />
                            </Grid>
                        </Controls:Card>

                        <Controls:Card Margin="0,0,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Controls:TextBlock Text="Show Capture Image" />

                                <Controls:ToggleSwitch
                                    x:Name="showImage"
                                    Grid.Column="1"
                                    Click="ConfigSwitch_Toggle"
                                    IsChecked="{Binding ShowImage}" />
                            </Grid>
                        </Controls:Card>

                        <Controls:Button Click="ConfigSubmit_Click" Content="Submit" />
                    </StackPanel>
                </Grid>

                <Controls:Card
                    x:Name="captureCard"
                    Grid.Row="2"
                    Padding="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            x:Name="captureCardButton"
                            Margin="15,55,0,10"
                            VerticalAlignment="Top"
                            Orientation="Horizontal">

                            <Controls:Button
                                Width="{Binding ButtonWidth}"
                                Height="{Binding ButtonWidth}"
                                Padding="0"
                                VerticalAlignment="Top"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Click="Button_OriginalTTS"
                                Icon="{wpfui:SymbolIcon Symbol=Speaker216,
                                                        Filled=False}"
                                ToolTip="Speak" />

                            <Controls:Button
                                Width="{Binding ButtonWidth}"
                                Height="{Binding ButtonWidth}"
                                Margin="2,0,0,0"
                                Padding="0"
                                VerticalAlignment="Top"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Click="Button_Copy"
                                Icon="{wpfui:SymbolIcon Symbol=Copy24,
                                                        Filled=False}"
                                Tag="{Binding Text, ElementName=ocrText}"
                                ToolTip="Copy" />
                        </StackPanel>

                        <Grid
                            Grid.Column="1"
                            Margin="5,0,0,0"
                            VerticalAlignment="Top">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--  Capture Image  -->
                            <Controls:Image
                                x:Name="captureImage"
                                Grid.Row="0"
                                Grid.Column="0"
                                Source="/src/images/applicationIcon.ico"
                                Stretch="Uniform" />

                            <!--  On Image Word  Buttons  -->
                            <ItemsControl
                                Name="AltoText"
                                Grid.Row="0"
                                Grid.Column="0"
                                Width="{Binding Width, ElementName=captureImage}"
                                Height="{Binding Height, ElementName=captureImage}"
                                MinWidth="{Binding MinWidth, ElementName=captureImage}"
                                MinHeight="{Binding MinHeight, ElementName=captureImage}"
                                MaxWidth="{Binding MaxWidth, ElementName=captureImage}"
                                MaxHeight="{Binding MaxHeight, ElementName=captureImage}">

                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Controls:Button
                                                Width="{Binding Width}"
                                                Height="{Binding Height}"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderBrush="{wpfui:ThemeResource AccentTextFillColorSecondaryBrush}"
                                                BorderThickness="1"
                                                Opacity="0.6" />

                                            <Controls:Button
                                                Uid="{Binding Uid}"
                                                Width="{Binding Width}"
                                                Height="{Binding Height}"
                                                Padding="0"
                                                Background="{wpfui:ThemeResource AccentTextFillColorPrimaryBrush}"
                                                Click="Button_Message"
                                                MouseOverBackground="{wpfui:ThemeResource AccentTextFillColorDisabledBrush}"
                                                Opacity="0.2"
                                                Tag="{Binding SourceLanguage}"
                                                ToolTip="{Binding Word}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>

                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding X}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <RotateTransform Angle="{Binding Angle}" />
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                            </ItemsControl>

                            <!--  Confirm Overlay  -->
                            <Border
                                x:Name="Control_Confirm_Overlay"
                                Grid.Row="0"
                                Grid.Column="0"
                                Background="#4C000000">
                                <Controls:Button
                                    Width="76"
                                    Height="56.52"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Click="Confirm_Click"
                                    Icon="{wpfui:SymbolIcon Symbol=Checkmark24,
                                                            Filled=True}"
                                    ToolTip="Confirm" />
                            </Border>

                            <!--  Vertical Image Rotation Control  -->
                            <Border
                                x:Name="rotationDragControl"
                                Grid.Column="1"
                                Width="28"
                                Margin="0,0,0,20"
                                Background="{wpfui:ThemeResource ApplicationBackgroundBrush}"
                                BorderBrush="{wpfui:ThemeResource ControlElevationBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Cursor="SizeNS"
                                MouseLeftButtonDown="RotationControl_MouseLeftButtonDown"
                                MouseLeftButtonUp="RotationControl_MouseLeftButtonUp"
                                MouseMove="RotationControl_MouseMove"
                                Opacity="0.85"
                                ToolTip="Click and drag UP/DOWN to rotate image">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <wpfui:SymbolIcon
                                        Grid.Row="0"
                                        Margin="0,6,0,0"
                                        Cursor="Hand"
                                        FontSize="12"
                                        Foreground="{wpfui:ThemeResource TextFillColorSecondaryBrush}"
                                        MouseLeftButtonDown="RotateRight_Click"
                                        Symbol="ArrowUp24"
                                        ToolTip="Rotate Right" />

                                    <StackPanel
                                        Grid.Row="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                        <wpfui:SymbolIcon
                                            FontSize="16"
                                            Foreground="{wpfui:ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Symbol="ArrowRotateClockwise24" />
                                        <TextBlock
                                            x:Name="rotationAngleText"
                                            Margin="0,2,0,0"
                                            HorizontalAlignment="Center"
                                            FontSize="10"
                                            FontWeight="SemiBold"
                                            Foreground="{wpfui:ThemeResource TextFillColorPrimaryBrush}"
                                            Text="0°" />
                                    </StackPanel>

                                    <wpfui:SymbolIcon
                                        Grid.Row="2"
                                        Margin="0,0,0,6"
                                        Cursor="Hand"
                                        FontSize="12"
                                        Foreground="{wpfui:ThemeResource TextFillColorSecondaryBrush}"
                                        MouseLeftButtonDown="RotateLeft_Click"
                                        Symbol="ArrowDown24"
                                        ToolTip="Rotate Left" />
                                </Grid>
                            </Border>

                            <!--  Horizontal Image Scaling Control  -->
                            <Border
                                x:Name="scalingDragControl"
                                Grid.Row="1"
                                Grid.Column="0"
                                Height="28"
                                Margin="0,0,20,0"
                                Background="{wpfui:ThemeResource ApplicationBackgroundBrush}"
                                BorderBrush="{wpfui:ThemeResource ControlElevationBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Cursor="SizeWE"
                                MouseLeftButtonDown="ScalingControl_MouseLeftButtonDown"
                                MouseLeftButtonUp="ScalingControl_MouseLeftButtonUp"
                                MouseMove="ScalingControl_MouseMove"
                                Opacity="0.85"
                                ToolTip="Click and drag LEFT/RIGHT to scale image">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <wpfui:SymbolIcon
                                        Grid.Column="0"
                                        Margin="6,0,0,0"
                                        Cursor="Hand"
                                        FontSize="12"
                                        Foreground="{wpfui:ThemeResource TextFillColorSecondaryBrush}"
                                        MouseLeftButtonDown="ScaleDown_Click"
                                        Symbol="ArrowLeft24"
                                        ToolTip="Scale Down" />

                                    <StackPanel
                                        Grid.Column="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <wpfui:SymbolIcon
                                            FontSize="14"
                                            Foreground="{wpfui:ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Symbol="ArrowFit24" />
                                        <TextBlock
                                            x:Name="scalingText"
                                            Margin="4,0,0,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="10"
                                            FontWeight="SemiBold"
                                            Foreground="{wpfui:ThemeResource TextFillColorPrimaryBrush}"
                                            Text="100%" />
                                    </StackPanel>

                                    <wpfui:SymbolIcon
                                        Grid.Column="2"
                                        Margin="0,0,6,0"
                                        Cursor="Hand"
                                        FontSize="12"
                                        Foreground="{wpfui:ThemeResource TextFillColorSecondaryBrush}"
                                        MouseLeftButtonDown="ScaleUp_Click"
                                        Symbol="ArrowRight24"
                                        ToolTip="Scale Up" />
                                </Grid>
                            </Border>

                            <!--  Undo  -->
                            <Controls:Button
                                x:Name="Contol_Undo"
                                Grid.Row="1"
                                Grid.Column="1"
                                Width="28"
                                Padding="5"
                                Click="Undo_Click"
                                Icon="{wpfui:SymbolIcon Symbol=ArrowUndo24,
                                                        Filled=True}"
                                ToolTip="Undo" />
                        </Grid>

                        <wpfui:CardExpander
                            x:Name="translationExpander"
                            Grid.ColumnSpan="2"
                            Padding="14,8"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="{wpfui:ThemeResource ApplicationBackgroundBrush}"
                            BorderBrush="{wpfui:ThemeResource ControlElevationBorderBrush}"
                            ContentPadding="0"
                            CornerRadius="0,0,8,0">
                            <wpfui:CardExpander.Header>
                                <Grid
                                    x:Name="expanderHeader"
                                    Height="20"
                                    VerticalAlignment="Center">
                                    <wpfui:SymbolIcon
                                        VerticalAlignment="Center"
                                        FontSize="22"
                                        Symbol="Translate24" />
                                </Grid>
                            </wpfui:CardExpander.Header>

                            <Border
                                x:Name="expanderContent"
                                Padding="14,16,14,16"
                                Background="{wpfui:ThemeResource ApplicationBackgroundBrush}"
                                CornerRadius="0,0,8,0">
                                <local:TranslationBox
                                    x:Name="translationImage"
                                    VerticalAlignment="Top"
                                    ButtonWidth="{Binding ButtonWidth}" />
                            </Border>
                        </wpfui:CardExpander>
                    </Grid>
                </Controls:Card>

                <Controls:Card
                    x:Name="ocrCard"
                    Grid.Row="3"
                    Margin="0,3,0,0">
                    <Controls:TextBlock
                        x:Name="ocrText"
                        Margin="45,0,0,0"
                        Text="ocrText"
                        TextWrapping="Wrap" />
                </Controls:Card>

                <Controls:Card
                    x:Name="originalCard"
                    Grid.Row="4"
                    Margin="0,3,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Controls:Button
                            x:Name="originalTTS"
                            Width="{Binding ButtonWidth}"
                            Height="{Binding ButtonWidth}"
                            Padding="0"
                            VerticalAlignment="Top"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Click="Button_OriginalTTS"
                            Icon="{wpfui:SymbolIcon Symbol=Speaker216,
                                                    Filled=False}"
                            ToolTip="Speak" />

                        <Controls:Button
                            Grid.Column="1"
                            Width="{Binding ButtonWidth}"
                            Height="{Binding ButtonWidth}"
                            Margin="2,0,0,0"
                            Padding="0"
                            VerticalAlignment="Top"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Click="Button_Copy"
                            Icon="{wpfui:SymbolIcon Symbol=Copy24,
                                                    Filled=False}"
                            Tag="{Binding Text, ElementName=ocrText}"
                            ToolTip="Copy" />

                        <Controls:DynamicScrollViewer
                            x:Name="originalScrollView"
                            Grid.Column="2"
                            IsScrollingVertically="True"
                            VerticalScrollBarVisibility="Visible">
                            <Grid Margin="5,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <wpfui:ProgressRing
                                    x:Name="originalWordsLoading"
                                    Width="{Binding ButtonWidth}"
                                    Height="{Binding ButtonWidth}"
                                    Foreground="{wpfui:ThemeResource TextFillColorPrimaryBrush}"
                                    IsIndeterminate="True" />

                                <StackPanel Grid.Column="1">
                                    <ItemsControl Name="originalWords">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <xControls:WordWrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Controls:Button
                                                    Width="{Binding Width}"
                                                    Height="{Binding Height}"
                                                    Margin="0"
                                                    Padding="{Binding Padding}"
                                                    HorizontalAlignment="Left"
                                                    Background="{wpfui:ThemeResource CardBackgroundFillColorDefault}"
                                                    BorderThickness="{Binding Border}"
                                                    Click="Button_Word"
                                                    Tag="{Binding SourceLanguage}"
                                                    ToolTip="{Binding Word}"
                                                    Visibility="{Binding Visibility}">

                                                    <Controls:Button.Content>
                                                        <wpfui:TextBlock
                                                            FontFamily="{Binding FontFace}"
                                                            FontSize="{Binding FontSizeS, Mode=OneWay}"
                                                            Text="{Binding Word}" />
                                                    </Controls:Button.Content>
                                                </Controls:Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </Controls:DynamicScrollViewer>
                    </Grid>
                </Controls:Card>

                <Controls:Card
                    x:Name="translatedCard"
                    Grid.Row="5"
                    Margin="0,3,0,0">
                    <local:TranslationBox x:Name="translationMessage" ButtonWidth="{Binding ButtonWidth}" />
                </Controls:Card>
            </Grid>

            <Controls:SnackbarPresenter
                x:Name="snackbarHost"
                Grid.Row="5"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom" />

        </Grid>

        <!--  Processing Overlay covering the entire window edge-to-edge  -->
        <Border
            x:Name="ProcessImageOverlay"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Panel.ZIndex="999"
            Background="#90000000"
            Visibility="Collapsed">
            <Viewbox
                x:Name="ProcessImageOverlayViewbox"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Stretch="Uniform">
                <StackPanel
                    Margin="10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <wpfui:ProgressRing
                        Width="18"
                        Height="18"
                        Margin="0,0,8,0"
                        Foreground="White"
                        IsIndeterminate="True" />
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="Processing..." />
                </StackPanel>
            </Viewbox>
        </Border>
    </Grid>
</Controls:FluentWindow>
