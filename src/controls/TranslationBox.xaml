<UserControl
    x:Class="ScreenLookup.src.controls.TranslationBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ScreenLookup.src.controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Controls:Button
            x:Name="SpeakButton"
            Width="{Binding ButtonWidth, RelativeSource={RelativeSource AncestorType=local:TranslationBox}}"
            Height="{Binding ButtonWidth, RelativeSource={RelativeSource AncestorType=local:TranslationBox}}"
            Padding="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            Click="SpeakButton_Click"
            Icon="{wpfui:SymbolIcon Symbol=Speaker216,
                                    Filled=False}"
            ToolTip="Speak" />

        <Controls:Button
            x:Name="CopyButton"
            Grid.Column="1"
            Width="{Binding ButtonWidth, RelativeSource={RelativeSource AncestorType=local:TranslationBox}}"
            Height="{Binding ButtonWidth, RelativeSource={RelativeSource AncestorType=local:TranslationBox}}"
            Margin="2,0,0,0"
            Padding="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            Click="CopyButton_Click"
            Icon="{wpfui:SymbolIcon Symbol=Copy24,
                                    Filled=False}"
            ToolTip="Copy" />

        <Controls:DynamicScrollViewer
            x:Name="translatedScrollViewer"
            Grid.Column="2"
            Margin="5,0,0,0"
            IsScrollingVertically="True"
            VerticalScrollBarVisibility="Visible">

            <StackPanel Orientation="Vertical">
                <WrapPanel Orientation="Horizontal">
                    <StackPanel Orientation="Vertical">
                        <Controls:TextBlock
                            x:Name="TranslatedText"
                            Margin="2,2,10,2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontFamily="{Binding DataContext.FontFace, RelativeSource={RelativeSource AncestorType=local:TranslationBox}}"
                            FontSize="{Binding DataContext.FontSizeS, RelativeSource={RelativeSource AncestorType=local:TranslationBox}}"
                            TextWrapping="Wrap" />

                        <!--  Phonetic  -->
                        <Controls:TextBlock
                            x:Name="PhoneticTextElement"
                            Margin="2,2,2,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontSize="{Binding DataContext.FontSizeS, RelativeSource={RelativeSource AncestorType=local:TranslationBox}}"
                            Foreground="{wpfui:ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                    </StackPanel>

                    <wpfui:ProgressRing
                        x:Name="Loading"
                        Width="{Binding ButtonWidth, RelativeSource={RelativeSource AncestorType=local:TranslationBox}}"
                        Height="{Binding ButtonWidth, RelativeSource={RelativeSource AncestorType=local:TranslationBox}}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Foreground="{wpfui:ThemeResource TextFillColorPrimaryBrush}"
                        IsIndeterminate="True" />

                    <Controls:Button
                        x:Name="Refresh"
                        Width="{Binding ButtonWidth, RelativeSource={RelativeSource AncestorType=local:TranslationBox}}"
                        Height="{Binding ButtonWidth, RelativeSource={RelativeSource AncestorType=local:TranslationBox}}"
                        Padding="0"
                        VerticalAlignment="Top"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Click="Refresh_Click"
                        Icon="{wpfui:SymbolIcon Symbol=ArrowClockwise24,
                                                Filled=False}"
                        ToolTip="Refresh" />
                </WrapPanel>

                <!--  Extra Meanings  -->
                <ItemsControl
                    x:Name="ExtraMeaningsList"
                    Margin="2,2,2,0"
                    Visibility="Collapsed">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical">
                                <TextBlock
                                    FontFamily="{Binding DataContext.FontFace, RelativeSource={RelativeSource AncestorType=local:TranslationBox}}"
                                    FontSize="{Binding DataContext.FontSizeS, RelativeSource={RelativeSource AncestorType=local:TranslationBox}}"
                                    FontWeight="Bold"
                                    Foreground="{wpfui:ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Text="{Binding Pos}" />
                                <TextBlock
                                    FontFamily="{Binding DataContext.FontFace, RelativeSource={RelativeSource AncestorType=local:TranslationBox}}"
                                    FontSize="{Binding DataContext.FontSizeS, RelativeSource={RelativeSource AncestorType=local:TranslationBox}}"
                                    Foreground="{wpfui:ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{Binding MeaningsFormatted}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Controls:DynamicScrollViewer>
    </Grid>
</UserControl>
