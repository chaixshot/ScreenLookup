<UserControl
    x:Class="ScreenLookup.src.controls.WordFlyout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ScreenLookup.src.controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    mc:Ignorable="d">

    <Controls:Flyout
        x:Name="flayOut"
        Padding="0"
        IsOpen="{Binding IsOpen, Mode=TwoWay}"
        Placement="Top">

        <Controls:Flyout.RenderTransform>
            <TranslateTransform x:Name="mTransform" />
        </Controls:Flyout.RenderTransform>

        <StackPanel>
            <StackPanel MaxWidth="{Binding WidthX}" MaxHeight="{Binding HeightX}">
                <!--  Original  -->
                <local:TranslationBox
                    x:Name="translationOriginalWord"
                    Margin="10,10,10,0"
                    VerticalAlignment="Center"
                    ButtonWidth="{Binding ButtonWidth}" />

                <!--  Translation  -->
                <local:TranslationBox
                    x:Name="translationWord"
                    Margin="10,10,10,0"
                    VerticalAlignment="Center"
                    ButtonWidth="{Binding ButtonWidth}" />

                <!--  Paragraph  -->
                <StackPanel
                    x:Name="messageSection"
                    MaxWidth="{Binding WidthX}"
                    MaxHeight="{Binding HeightX}"
                    Margin="0,10,0,0">
                    <Controls:NavigationViewItemSeparator />

                    <!--  Paragraph Original  -->
                    <Grid Margin="10,10,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Controls:Button
                            Width="{Binding ButtonWidth}"
                            Height="{Binding ButtonWidth}"
                            Padding="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Click="Button_OriginalMessageTTS"
                            Icon="{wpfui:SymbolIcon Symbol=Speaker216,
                                                    Filled=False}"
                            ToolTip="Speak" />

                        <Controls:Button
                            Grid.Column="1"
                            Width="{Binding ButtonWidth}"
                            Height="{Binding ButtonWidth}"
                            Margin="2,0,0,0"
                            Padding="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Click="Button_Copy"
                            Icon="{wpfui:SymbolIcon Symbol=Copy24,
                                                    Filled=False}"
                            Tag="{Binding OriginalMessage}"
                            ToolTip="Copy" />

                        <Controls:DynamicScrollViewer
                            Grid.Column="2"
                            IsScrollingVertically="True"
                            VerticalScrollBarVisibility="Visible">

                            <WrapPanel Margin="5,0,0,0" Orientation="Horizontal">
                                <Controls:TextBlock
                                    x:Name="originalMessageBlock"
                                    Margin="2"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="{Binding FontFace}"
                                    FontSize="{Binding FontSizeS}"
                                    TextWrapping="Wrap" />
                            </WrapPanel>
                        </Controls:DynamicScrollViewer>
                    </Grid>

                    <!--  Paragraph Translated  -->
                    <local:TranslationBox
                        x:Name="translationMessage"
                        Margin="10,10,10,0"
                        VerticalAlignment="Center"
                        ButtonWidth="{Binding ButtonWidth}" />
                </StackPanel>

                <!--  Footer  -->
                <Border
                    Margin="0,10,0,0"
                    Padding="10,5,10,5"
                    Background="{wpfui:ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{wpfui:ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0">

                    <StackPanel Orientation="Horizontal">
                        <local:OpenBrowserButton
                            x:Name="openBrowser"
                            Width="{Binding ButtonWidth}"
                            Height="{Binding ButtonWidth}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            OriginalWord="{Binding OriginalWord}"
                            SourceLanguage="{Binding SourceLanguage}"
                            TargetLanguage="{Binding TargetLanguage}" />

                        <Controls:Button
                            x:Name="wordSave"
                            Width="{Binding ButtonWidth}"
                            Height="{Binding ButtonWidth}"
                            Margin="2,0,0,0"
                            Padding="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Click="Button_WordSave"
                            Icon="{wpfui:SymbolIcon Symbol=Star24,
                                                    Filled=False}"
                            ToolTip="Saved" />

                        <Controls:Button
                            x:Name="wordSaveScore"
                            Width="{Binding ButtonWidth}"
                            Height="{Binding ButtonWidth}"
                            Margin="2,0,0,0"
                            Padding="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Click="Button_WordAddScore"
                            Icon="{wpfui:SymbolIcon Symbol=StarEmphasis24,
                                                    Filled=True}"
                            ToolTip="+1 want to learn score" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </Controls:Flyout>
</UserControl>
