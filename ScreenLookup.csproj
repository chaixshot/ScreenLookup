<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest></ApplicationManifest>
    <ApplicationIcon>src\images\applicationIcon.ico</ApplicationIcon>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <PackageIcon>applicationIcon.ico</PackageIcon>
    <Title>ScreenLookup</Title>
    <Authors>H@mer</Authors>
    <Copyright>Copyright (c) 2025 H@mer and other contributors</Copyright>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="third-party\openvr\bin\androidarm64\**" />
    <Compile Remove="third-party\openvr\bin\linux32\**" />
    <Compile Remove="third-party\openvr\bin\linux64\**" />
    <Compile Remove="third-party\openvr\bin\linuxarm64\**" />
    <Compile Remove="third-party\openvr\bin\osx32\**" />
    <Compile Remove="third-party\openvr\codegen\**" />
    <Compile Remove="third-party\openvr\controller_callouts\**" />
    <Compile Remove="third-party\openvr\docs\**" />
    <Compile Remove="third-party\openvr\lib\**" />
    <Compile Remove="third-party\openvr\samples\**" />
    <Compile Remove="third-party\openvr\src\**" />
    <Compile Remove="third-party\ScreenGrab\**" />
    <EmbeddedResource Remove="third-party\openvr\bin\androidarm64\**" />
    <EmbeddedResource Remove="third-party\openvr\bin\linux32\**" />
    <EmbeddedResource Remove="third-party\openvr\bin\linux64\**" />
    <EmbeddedResource Remove="third-party\openvr\bin\linuxarm64\**" />
    <EmbeddedResource Remove="third-party\openvr\bin\osx32\**" />
    <EmbeddedResource Remove="third-party\openvr\codegen\**" />
    <EmbeddedResource Remove="third-party\openvr\controller_callouts\**" />
    <EmbeddedResource Remove="third-party\openvr\docs\**" />
    <EmbeddedResource Remove="third-party\openvr\lib\**" />
    <EmbeddedResource Remove="third-party\openvr\samples\**" />
    <EmbeddedResource Remove="third-party\openvr\src\**" />
    <EmbeddedResource Remove="third-party\ScreenGrab\**" />
    <None Remove="third-party\openvr\bin\androidarm64\**" />
    <None Remove="third-party\openvr\bin\linux32\**" />
    <None Remove="third-party\openvr\bin\linux64\**" />
    <None Remove="third-party\openvr\bin\linuxarm64\**" />
    <None Remove="third-party\openvr\bin\osx32\**" />
    <None Remove="third-party\openvr\codegen\**" />
    <None Remove="third-party\openvr\controller_callouts\**" />
    <None Remove="third-party\openvr\docs\**" />
    <None Remove="third-party\openvr\lib\**" />
    <None Remove="third-party\openvr\samples\**" />
    <None Remove="third-party\openvr\src\**" />
    <None Remove="third-party\ScreenGrab\**" />
    <Page Remove="third-party\openvr\bin\androidarm64\**" />
    <Page Remove="third-party\openvr\bin\linux32\**" />
    <Page Remove="third-party\openvr\bin\linux64\**" />
    <Page Remove="third-party\openvr\bin\linuxarm64\**" />
    <Page Remove="third-party\openvr\bin\osx32\**" />
    <Page Remove="third-party\openvr\codegen\**" />
    <Page Remove="third-party\openvr\controller_callouts\**" />
    <Page Remove="third-party\openvr\docs\**" />
    <Page Remove="third-party\openvr\lib\**" />
    <Page Remove="third-party\openvr\samples\**" />
    <Page Remove="third-party\openvr\src\**" />
    <Page Remove="third-party\ScreenGrab\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="third-party\openvr\.git" />
    <None Remove="third-party\openvr\.gitattributes" />
    <None Remove="third-party\openvr\CMakeLists.txt" />
    <None Remove="third-party\openvr\LICENSE" />
    <None Remove="third-party\openvr\README.md" />
    <None Remove="third-party\openvr\Toolchain-clang.cmake" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="src\images\applicationIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="src\images\H@mer.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="GTranslate" Version="2.3.1" />
    <PackageReference Include="HotkeyUtility" Version="2.1.0" />
    <PackageReference Include="HunspellSharp" Version="1.0.3" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="Porter2Stemmer" Version="1.0.0" />
    <PackageReference Include="TesseractOCR" Version="5.5.2" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DirectX" Version="3.8.3" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="WPF-UI.Tray" Version="4.3.0" />
    <PackageReference Include="WpfScreenHelper" Version="2.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="third-party\ScreenGrab\src\ScreenGrab\ScreenGrab.csproj" />
  </ItemGroup>

  <ItemGroup Condition="('$(RuntimeIdentifier)' != '' And $(RuntimeIdentifier.Contains('x86'))) Or '$(PlatformTarget)' == 'x86' Or '$(Platform)' == 'x86' Or '$(Platform)' == 'Win32'">
    <Content Include="third-party\openvr\bin\win32\openvr_api.dll">
      <Link>openvr_api.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup Condition="!('$(RuntimeIdentifier)' != '' And $(RuntimeIdentifier.Contains('x86'))) And '$(PlatformTarget)' != 'x86' And '$(Platform)' != 'x86' And '$(Platform)' != 'Win32'">
    <Content Include="third-party\openvr\bin\win64\openvr_api.dll">
      <Link>openvr_api.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Update="src\images\applicationIcon.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Update="src\images\applicationIcon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="src\sounds\ready.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="src\sounds\recenter.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="src\sounds\screenshot.wav">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
